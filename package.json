{
  "name": "cj-nuxt-travel-log",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"nuxt dev\" \"pnpm dev:db\"",
    "dev:db": "turso dev --db-file local.db",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.2",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.3.0",
    "daisyui": "^5.7.19",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-tailwindcss": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
